<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/item_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants">

    <ImageView
        android:id="@+id/channelLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_channel_placeholder"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="Logo canale" />

    <TextView
        android:id="@+id/channelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nome Canale"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/channelGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gruppo"
        android:textColor="#8899aa"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/channelEpg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#90caf9"
        android:textSize="9sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/epgProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="2dp"
        android:max="100"
        android:progressDrawable="@drawable/epg_progress"
        android:visibility="gone" />

</LinearLayout>
